# Production Environment Configuration for Vercel Deployment
# Uses same-origin reverse proxy paths to completely eliminate browser CORS errors.
# Vercel rewrites defined in vercel.json proxy these to Google Cloud Run server-to-server.
# Catalog Service: https://product-catalog-service-518971663061.us-central1.run.app
VITE_CATALOG_API_URL=/api/catalog

# Content Service: https://content-service-518971663061.us-central1.run.app
VITE_CONTENT_API_URL=/api/content

# Store Consumer Application (Live Deployed App)
VITE_STORE_URL=https://mycommerce-phi.vercel.app
