# Product Catalog Service (Google Cloud Run API)
# Defaults to live Cloud Run deployment if omitted
VITE_CATALOG_API_URL=https://product-catalog-service-518971663061.us-central1.run.app
# Product Catalog Service
# Uses Vite reverse proxy (/api/catalog) to eliminate browser CORS errors.
# Proxies to https://product-catalog-service-518971663061.us-central1.run.app/api/v1
VITE_CATALOG_API_URL=/api/catalog

# Content / Experience CMS Service (Google Cloud Run API)
# Defaults to live Cloud Run deployment if omitted
VITE_CONTENT_API_URL=https://content-service-518971663061.us-central1.run.app
# Content / Experience CMS Service
# Uses Vite reverse proxy (/api/content) to eliminate browser CORS errors.
# Proxies to https://content-service-518971663061.us-central1.run.app/api/v1
VITE_CONTENT_API_URL=/api/content

# Store Consumer Application URL (Live Deployed Vercel App)
# Used for live "Preview in Store" iframe and deep links
VITE_STORE_URL=https://mycommerce-phi.vercel.app
